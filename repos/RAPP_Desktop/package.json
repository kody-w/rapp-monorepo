{
  "name": "rapp-desktop",
  "private": true,
  "version": "2.0.0",
  "description": "Secure Electron companion for the RAPP Brainstem",
  "author": "Wildhaven Homes LLC",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "1.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.rapp.desktop",
    "productName": "RAPP Desktop",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "rapp_os",
        "to": "rapp_os",
        "filter": [
          "**/*.py",
          "requirements.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "build/icon.png",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
