{
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-static-apis/main/api/rapp-work/schemas/receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "artifact_count": {
      "minimum": 1,
      "type": "integer"
    },
    "artifacts": {
      "items": {
        "$ref": "common.schema.json#/$defs/artifactHash"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority": {
      "$ref": "common.schema.json#/$defs/authority"
    },
    "binding": {
      "$ref": "common.schema.json#/$defs/receiptBinding"
    },
    "fixture_mode": {
      "type": "boolean"
    },
    "fixture_notice": {
      "type": "string"
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/generated"
    },
    "manifest": {
      "$ref": "common.schema.json#/$defs/artifactHash"
    },
    "schema": {
      "const": "rapp-work-static-api-receipt/1.0"
    }
  },
  "required": [
    "schema",
    "generated",
    "api_version",
    "fixture_mode",
    "authority",
    "binding",
    "manifest",
    "artifact_count",
    "artifacts"
  ],
  "title": "Immutable RAPP Work build receipt",
  "type": "object"
}
