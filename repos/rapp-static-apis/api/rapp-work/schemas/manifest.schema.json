{
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-static-apis/main/api/rapp-work/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "api": {
      "additionalProperties": false,
      "properties": {
        "pages_base": {
          "format": "uri",
          "type": "string"
        },
        "raw_base": {
          "format": "uri",
          "type": "string"
        },
        "version": {
          "const": "v1"
        }
      },
      "required": [
        "version",
        "raw_base",
        "pages_base"
      ],
      "type": "object"
    },
    "authority": {
      "$ref": "common.schema.json#/$defs/authority"
    },
    "boundary": {
      "additionalProperties": false,
      "properties": {
        "generated": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root_build": {
          "const": "build.py"
        }
      },
      "required": [
        "inputs",
        "generated",
        "root_build"
      ],
      "type": "object"
    },
    "catalogs": {
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "items": {
            "$ref": "common.schema.json#/$defs/catalogItem"
          },
          "minItems": 1,
          "type": "array"
        },
        "sdks": {
          "items": {
            "$ref": "common.schema.json#/$defs/catalogItem"
          },
          "minItems": 1,
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "common.schema.json#/$defs/catalogItem"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "sdks",
        "plugins",
        "skills"
      ],
      "type": "object"
    },
    "fixture_notice": {
      "type": "string"
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/generated"
    },
    "mode": {
      "enum": [
        "production",
        "local-development-fixture"
      ]
    },
    "offline_seed": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "json"
        },
        "verification": {
          "const": "sha256-required"
        }
      },
      "required": [
        "format",
        "verification"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "const": "rapp-work"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "protocol": {
          "const": "RAPP/1"
        },
        "role": {
          "const": "non-authoritative-discovery"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "protocol",
        "role"
      ],
      "type": "object"
    },
    "release_policy": {
      "additionalProperties": false,
      "properties": {
        "commit_pattern": {
          "const": "^[0-9a-f]{40}$"
        },
        "final_state": {
          "const": "final"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "pending_state": {
          "const": "awaiting-downstream-commit"
        },
        "raw_url_template": {
          "type": "string"
        },
        "require_commit_pinned_raw_url": {
          "const": true
        }
      },
      "required": [
        "pending_state",
        "final_state",
        "commit_pattern",
        "raw_url_template",
        "require_commit_pinned_raw_url",
        "hash_algorithm"
      ],
      "type": "object"
    },
    "rollback": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "strategy": {
          "const": "receipt-plus-commit-pin"
        }
      },
      "required": [
        "strategy",
        "rules"
      ],
      "type": "object"
    },
    "schema": {
      "const": "rapp-work-static-api-manifest/1.0"
    }
  },
  "required": [
    "schema",
    "mode",
    "generated",
    "api",
    "authority",
    "profile",
    "boundary",
    "release_policy",
    "catalogs",
    "offline_seed",
    "rollback"
  ],
  "title": "RAPP Work static API production manifest",
  "type": "object"
}
