{
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-static-apis/main/api/rapp-work/schemas/artifact-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "artifact_count": {
      "minimum": 1,
      "type": "integer"
    },
    "artifacts": {
      "items": {
        "$ref": "common.schema.json#/$defs/artifactSnapshotRecord"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority": {
      "$ref": "common.schema.json#/$defs/authority"
    },
    "fixture_mode": {
      "type": "boolean"
    },
    "fixture_notice": {
      "type": "string"
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/generated"
    },
    "schema": {
      "const": "rapp-work-static-api-artifact-snapshot/1.0"
    }
  },
  "required": [
    "schema",
    "generated",
    "api_version",
    "fixture_mode",
    "authority",
    "artifact_count",
    "artifacts"
  ],
  "title": "Content-addressed RAPP Work artifact snapshot",
  "type": "object"
}
