{
  "name": "rapp-mirror",
  "version": "0.2.0",
  "private": true,
  "description": "RAPP Mirror \u2014 talk to your brainstem: voice, gaze, gestures, and Brain Surgeons operating on the same live patient.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings --test common/envelope.test.ts common/gestures.test.ts common/agentcard.test.ts common/agentshare.test.ts common/qr.test.ts electron/brainstem.test.ts electron/stt.test.ts electron/forge.test.ts electron/rehearsal.test.ts electron/sessionstore.test.ts electron/license-verify.test.ts electron/settings.test.ts electron/engine.test.ts electron/diagnostics.test.ts electron/doctor.test.ts electron/wallet.test.ts electron/agentshare.test.ts",
    "start": "electron .",
    "postinstall": "node scripts/setup-vision-assets.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:release": "npm run build && electron-builder --mac --publish never -c.mac.notarize=true",
    "test:ios": "cd ios/RappMirrorPackage && swift test",
    "test:ios:ui": "cd ios && xcodebuild test -workspace RappMirror.xcworkspace -scheme RappMirror -destination 'platform=iOS Simulator,name=iPhone 17 Pro' -only-testing:RappMirrorUITests",
    "test:e2e": "node --experimental-transform-types --no-warnings --test test/e2e/mirror-e2e.test.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9-preview.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "adm-zip": "^0.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "1.0.4"
  },
  "author": "Wildhaven Homes LLC",
  "build": {
    "appId": "dev.rapp.mirror",
    "productName": "RAPP Mirror",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "voice",
        "to": "voice",
        "filter": [
          "server.py",
          "setup.sh"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "The mirror listens only when you enable hearing \u2014 narration and caf\u00e9-mode color confirms.",
        "NSCameraUsageDescription": "Eye and hand tracking run entirely on this device; camera frames never leave the app.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "RAPP agent",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.python-script"
            ],
            "CFBundleTypeExtensions": [
              "py"
            ]
          }
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "RAPP agent card",
            "CFBundleURLSchemes": [
              "rapp"
            ]
          }
        ]
      }
    },
    "dmg": {
      "sign": false
    },
    "protocols": [
      {
        "name": "RAPP agent card",
        "schemes": [
          "rapp"
        ]
      }
    ]
  }
}